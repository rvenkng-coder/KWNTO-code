# PocketBase admin credentials
# Password must be 10 or more characters
KWNTO_ADMIN_EMAIL=
KWNTO_ADMIN_PASSWORD=

# Production (compose.prod.yaml; see docs/developer/backend.md "The production stack")
# Set to 1 on the VM only
KWNTO_PRODUCTION=
# The public https:// address of the app
KWNTO_PUBLIC_URL=
# Largest request body Caddy accepts, in MB (empty means 1024)
KWNTO_MAX_REQUEST_MB=
# Host folder for backups (empty means ./backups)
KWNTO_BACKUP_DIR=
# Tailscale auth key and machine name
TS_AUTHKEY=
TS_HOSTNAME=
