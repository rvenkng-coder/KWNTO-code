{
  "name": "kwnto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite frontend",
    "build": "tsc -b && vite build frontend",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview frontend",
    "test:unit": "vitest run --project unit",
    "dev:backend": "docker compose -f compose.dev.yaml up --build",
    "test:container": "vitest run --project container",
    "spike:realtime": "rm -rf spike/realtime/results && docker compose -f spike/realtime/compose.yaml down -v && docker compose -f spike/realtime/compose.yaml up -d --wait && node spike/realtime/seed.ts && npx playwright test -c spike/realtime/playwright.config.ts; code=$?; docker compose -f spike/realtime/compose.yaml down -v; exit $code",
    "check:docs": "node scripts/check-doc-links.ts",
    "check:plan": "node scripts/check-plan.ts",
    "check:hygiene": "node scripts/check-test-hygiene.ts",
    "check:breaks": "node scripts/run-breaks.ts",
    "check:probes": "node scripts/run-probes.ts",
    "check:quality": "node scripts/check-changed-quality.ts",
    "check:task": "node scripts/check-task.ts",
    "ping:model": "node scripts/ping-local-model.ts",
    "prepare-local-run": "node scripts/prepare-local-run.ts",
    "report:quality": "node scripts/check-changed-quality.ts --report",
    "report:escape-rate": "node scripts/escape-rate.ts",
    "lint": "eslint . && node scripts/check-perf-comments.ts && npm run check:docs && npm run check:plan",
    "test:rules": "node scripts/with-pocketbase.ts vitest run --project rules",
    "test:e2e": "node scripts/with-pocketbase.ts playwright test",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run test:container && npm run test:rules && npm run test:e2e",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "docx": "^9.16.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "pocketbase": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
