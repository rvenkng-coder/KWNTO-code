{
  "name": "kwnto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test:unit": "vitest run --project unit",
    "dev:backend": "docker compose -f compose.dev.yaml up --build",
    "test:container": "vitest run --project container",
    "spike:realtime": "rm -rf spike/realtime/results && docker compose -f spike/realtime/compose.yaml down -v && docker compose -f spike/realtime/compose.yaml up -d --wait && node spike/realtime/seed.ts && npx playwright test -c spike/realtime/playwright.config.ts; code=$?; docker compose -f spike/realtime/compose.yaml down -v; exit $code",
    "lint": "eslint . && node scripts/check-perf-comments.ts",
    "test:rules": "node scripts/with-pocketbase.ts vitest run --project rules",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run test:container && npm run test:rules"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "pocketbase": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
