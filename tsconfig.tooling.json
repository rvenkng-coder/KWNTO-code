{
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.tooling.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": ["scripts", "tests", "e2e", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["tests/probes"]
}
